# Storage Account Configuration
# このファイルをコピーして terraform.tfvars として使用してください

# Required Variables
storage_account_name = "your-unique-storage-name"  # 3-24文字、小文字と数字のみ、グローバルで一意である必要があります

# Optional Variables (デフォルト値を変更する場合のみ設定)
# resource_group_name = "rg-storage-custom"
# location = "Japan West"
# account_tier = "Standard"
# account_replication_type = "GRS"
# account_kind = "StorageV2"

# Security Settings
# allow_nested_items_to_be_public = false
# shared_access_key_enabled = true
# public_network_access_enabled = true

# Storage Containers (必要に応じて追加)
containers = [
  {
    name        = "documents"
    access_type = "private"
  },
  {
    name        = "images"
    access_type = "private"
  }
]

# Tags
tags = {
  Environment = "Development"
  Project     = "Azure-Practice"
  ManagedBy   = "Terraform"
  Owner       = "Your-Name"
}