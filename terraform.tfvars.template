# COPY THIS FILE TO terraform.tfvars AND UPDATE THE VALUES

# Azure Subscription Information
# ==============================
subscription_id = "YOUR_AZURE_SUBSCRIPTION_ID_HERE"

# Resource Configuration
# ======================
resource_group_name = "rg-storage-demo"
location = "Japan East"

# Storage Account Configuration
# =============================
# NOTE: Storage account name must be globally unique across all of Azure
# Use lowercase letters and numbers only, 3-24 characters
storage_account_name = "YOUR_UNIQUE_STORAGE_NAME_HERE"

# Container and Blob Configuration
# =================================
container_name = "files"
blob_name = "uploaded-file.txt"
local_file_path = "./sample.txt"

# SECURITY NOTICE:
# ================
# Never commit this file (terraform.tfvars) to version control!
# It contains sensitive information like your Azure subscription ID.
# 
# The .gitignore file is configured to exclude *.tfvars files.
# Always verify that your terraform.tfvars file is not being tracked by Git.
#
# To check: run 'git status' and ensure terraform.tfvars is not listed